VITE_ARC_TIP_JAR_ADDRESS=0x44FD57BaeaAC3D2F0a20a8032840E00bd44E8668
VITE_ARC_CLAIM_LINK_ADDRESS=

# Optional server-side history override when deploying a replacement contract.
ARC_TIP_JAR_ADDRESS=0x44FD57BaeaAC3D2F0a20a8032840E00bd44E8668

# Arc Mainnet is not officially available yet. Add only after Arc publishes
# the official values and the Tip Jar contract has been deployed there.
# VITE_ARC_MAINNET_CHAIN_ID=
# VITE_ARC_MAINNET_RPC_URL=
# VITE_ARC_MAINNET_EXPLORER_URL=
# VITE_ARC_MAINNET_TIP_JAR_ADDRESS=

# Public Circle Modular Wallets browser configuration.
# Register this exact site origin as the Passkey domain in Circle Console.
VITE_CIRCLE_CLIENT_KEY=
VITE_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Public, explicit Bridge RPCs. All four are required; the app does not fall
# back to App Kit shared RPCs. Keep CSP connect-src in sync if hosts change.
VITE_BRIDGE_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_BRIDGE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_BRIDGE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_BRIDGE_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
